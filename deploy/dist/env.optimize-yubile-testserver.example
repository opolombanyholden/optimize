# ═════════════════════════════════════════════════════════════
# OptimiZe ERP — .env pour optimize.yubile-testserver.com
# ═════════════════════════════════════════════════════════════
# À copier vers `.env` sur le serveur, remplir les CHANGE_ME,
# puis exécuter : /usr/local/bin/ea-php83 artisan key:generate --force

APP_NAME="OptimiZe"
APP_ENV=production
APP_KEY=                                # ← sera généré par artisan
APP_DEBUG=false
APP_URL=https://optimize.yubile-testserver.com
APP_TIMEZONE=Africa/Libreville
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ─── Base PostgreSQL (via cPanel) ────────────────────────────
# Remplacer CPANELUSER par le login cPanel réel (préfixe imposé par cPanel).
# Exemple si login cPanel = "yubile" → DB = yubile_optimiz , USER = yubile_optprod
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=CPANELUSER_optimiz
DB_USERNAME=CPANELUSER_optprod
DB_PASSWORD=CHANGE_ME

# ─── Cache / session ─────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ─── Queue ───────────────────────────────────────────────────
# 'sync' = le plus simple sur cPanel mutualisé (jobs exécutés dans la requête)
QUEUE_CONNECTION=sync

# ─── SMTP (créer un compte mail cPanel : no-reply@optimize.yubile-testserver.com) ──
MAIL_MAILER=smtp
MAIL_HOST=mail.yubile-testserver.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@optimize.yubile-testserver.com
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@optimize.yubile-testserver.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public
SANCTUM_STATEFUL_DOMAINS=optimize.yubile-testserver.com
