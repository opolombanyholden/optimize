# ═════════════════════════════════════════════════════════════
# OptimiZe ERP — .env cPanel production
# ═════════════════════════════════════════════════════════════
# Coller dans .env à la racine de l'app côté serveur, puis :
#   php artisan key:generate --force

APP_NAME="OptimiZe"
APP_ENV=production
APP_KEY=                             # sera généré
APP_DEBUG=false
APP_URL=https://votredomaine.com
APP_TIMEZONE=Africa/Libreville
APP_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ─── Base de données PostgreSQL (via cPanel) ─────────────────
# Nom prefixé par le username cPanel : cpaneluser_optimiz
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=CPANELUSER_optimiz
DB_USERNAME=CPANELUSER_prod
DB_PASSWORD=CHANGE_ME

# ─── Cache & Session ─────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# ─── Queue ───────────────────────────────────────────────────
# 'sync' = exécution en ligne (simple, pas de worker à gérer)
# 'database' = à combiner avec cron worker (voir README)
QUEUE_CONNECTION=sync

# ─── Mail via cPanel SMTP ────────────────────────────────────
# Créer un compte mail dans cPanel → Email Accounts
MAIL_MAILER=smtp
MAIL_HOST=mail.votredomaine.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@votredomaine.com
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=ssl                  # ou 'tls' avec port 587
MAIL_FROM_ADDRESS="no-reply@votredomaine.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public
