# ═════════════════════════════════════════════════════════════
# OptimiZe ERP — Config Nginx (Laravel 12 + PHP-FPM 8.3)
# ═════════════════════════════════════════════════════════════
# À placer dans /etc/nginx/sites-available/optimiz.conf
# puis : ln -s /etc/nginx/sites-available/optimiz.conf /etc/nginx/sites-enabled/
#        nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name erp.example.com;
    # Redirection HTTP → HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name erp.example.com;
    root /var/www/optimiz/public;
    index index.php;

    # ─── Certificat SSL (Let's Encrypt recommandé) ─────────
    ssl_certificate     /etc/letsencrypt/live/erp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erp.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    # ─── Headers sécurité ──────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ─── Uploads (max 50Mo — cf. HasPiecesJointes) ─────────
    client_max_body_size 50M;

    # ─── Compression ───────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Bloquer accès direct aux fichiers cachés et .env
    location ~ /\.(?!well-known).* {
        deny all;
    }
    location ~ ^/(storage/framework|bootstrap/cache|\.env) {
        deny all;
    }

    # ─── PHP-FPM ───────────────────────────────────────────
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT   $realpath_root;
        fastcgi_read_timeout 300;
    }

    # Cache statique long pour assets Vite (hash dans le nom)
    location ~* ^/build/.*\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Logs
    access_log /var/log/nginx/optimiz.access.log;
    error_log  /var/log/nginx/optimiz.error.log warn;
}
