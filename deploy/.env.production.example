# ═════════════════════════════════════════════════════════════
# OptimiZe ERP — Configuration Production
# ═════════════════════════════════════════════════════════════
# À copier vers .env sur le serveur de production, puis renseigner
# les valeurs sensibles (marquées CHANGE_ME).

APP_NAME="OptimiZe"
APP_ENV=production
APP_KEY=CHANGE_ME                    # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://erp.example.com      # URL publique HTTPS
APP_TIMEZONE=Africa/Libreville
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# ─── Logs ────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ─── Base de données PostgreSQL 17 ───────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=optimiz_prod
DB_USERNAME=optimiz_prod
DB_PASSWORD=CHANGE_ME                # Fort — 32 caractères aléatoires
# Optionnel : DB_SSLMODE=require pour prod hostée

# ─── Cache & Session ─────────────────────────────────────────
CACHE_STORE=file                     # ou redis
SESSION_DRIVER=database              # persiste les sessions (utile en multi-worker)
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true           # HTTPS obligatoire
SESSION_SAME_SITE=lax

# ─── Queue (notifications, envois mail…) ─────────────────────
QUEUE_CONNECTION=database            # ou redis pour la perf
# Si redis :
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null

# ─── Mail SMTP ───────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Stockage fichiers ───────────────────────────────────────
FILESYSTEM_DISK=public
# Lien symbolique storage :  php artisan storage:link

# ─── Broadcast (websocket, optionnel) ────────────────────────
BROADCAST_CONNECTION=null

# ─── Sécurité ────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=erp.example.com
# HTTPS forcé côté Laravel via middleware ForceHttps si besoin
